   <!-- \uc0\u1057 \u1082 \u1088 \u1080 \u1087 \u1090  \u1076 \u1083 \u1103  \u1087 \u1086 \u1080 \u1089 \u1082 \u1072  \u1087 \u1086  \u1084 \u1077 \u1085 \u1102  -->\
   <script>\
       document.getElementById('searchInput').addEventListener('input', function(e) \{\
           let searchText = e.target.value.toLowerCase().trim();\
           let items = document.querySelectorAll('.menu-item');\
           let categories = document.querySelectorAll('.category-title');\
           let subtitles = document.querySelectorAll('.category-subtitle');\
\
           // \uc0\u1057 \u1085 \u1072 \u1095 \u1072 \u1083 \u1072  \u1087 \u1086 \u1082 \u1072 \u1079 \u1099 \u1074 \u1072 \u1077 \u1084  \u1074 \u1089 \u1077 \
           items.forEach(item => item.classList.remove('hidden'));\
           categories.forEach(cat => cat.classList.remove('hidden'));\
           subtitles.forEach(sub => sub.classList.remove('hidden'));\
\
           if (searchText.length > 0) \{\
               items.forEach(item => \{\
                   let text = item.innerText.toLowerCase();\
                   if (!text.includes(searchText)) \{\
                       item.classList.add('hidden');\
                   \}\
               \});\
\
               // \uc0\u1057 \u1082 \u1088 \u1099 \u1074 \u1072 \u1077 \u1084  \u1079 \u1072 \u1075 \u1086 \u1083 \u1086 \u1074 \u1082 \u1080 , \u1077 \u1089 \u1083 \u1080  \u1087 \u1086 \u1076  \u1085 \u1080 \u1084 \u1080  \u1085 \u1077 \u1090  \u1074 \u1080 \u1076 \u1080 \u1084 \u1099 \u1093  \u1101 \u1083 \u1077 \u1084 \u1077 \u1085 \u1090 \u1086 \u1074 \
               categories.forEach(cat => \{\
                   let nextEl = cat.nextElementSibling;\
                   let hasVisibleItems = false;\
\
                   while (nextEl && !nextEl.classList.contains('category-title')) \{\
                       if (nextEl.classList.contains('menu-item') && !nextEl.classList.contains('hidden')) \{\
                           hasVisibleItems = true;\
                           break;\
                       \}\
                       nextEl = nextEl.nextElementSibling;\
                   \}\
\
                   if (!hasVisibleItems) \{\
                       cat.classList.add('hidden');\
                   \}\
               \});\
\
               // \uc0\u1057 \u1082 \u1088 \u1099 \u1074 \u1072 \u1077 \u1084  \u1087 \u1086 \u1076 \u1079 \u1072 \u1075 \u1086 \u1083 \u1086 \u1074 \u1082 \u1080  (\u1085 \u1072 \u1087 \u1088 \u1080 \u1084 \u1077 \u1088  "\u1050 \u1086 \u1092 \u1077 "), \u1077 \u1089 \u1083 \u1080  \u1087 \u1086 \u1076  \u1085 \u1080 \u1084 \u1080  \u1085 \u1080 \u1095 \u1077 \u1075 \u1086  \u1085 \u1077  \u1085 \u1072 \u1081 \u1076 \u1077 \u1085 \u1086 \
               subtitles.forEach(sub => \{\
                   let nextEl = sub.nextElementSibling;\
                   let hasVisibleItems = false;\
\
                   while (nextEl && !nextEl.classList.contains('category-subtitle') && !nextEl.classList.contains('category-title')) \{\
                       if (nextEl.classList.contains('menu-item') && !nextEl.classList.contains('hidden')) \{\
                           hasVisibleItems = true;\
                           break;\
                       \}\
                       nextEl = nextEl.nextElementSibling;\
                   \}\
\
                   if (!hasVisibleItems) \{\
                       sub.classList.add('hidden');\
                   \}\
               \});\
           \}\
       \});\
   </script>\
